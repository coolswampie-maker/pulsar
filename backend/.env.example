# Скопируйте в backend/.env и заполните. Файл .env НЕ коммитить.
# Пример заполнен под боевой поддомен pulsar.jaglionrus.ru (VPS + Nginx + Gunicorn).

# Длинная случайная строка. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# На проде обязательно 0 (иначе видны трейсбеки и CORS открыт для всех).
DEBUG=0

# Домены, с которых доступен бэкенд (через запятую).
ALLOWED_HOSTS=pulsar.jaglionrus.ru

# Postgres в РФ (152-ФЗ). Пример для Timeweb/Yandex Cloud/Selectel/Reg.cloud:
#   DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/pulsar
# Если оставить пустым — используется локальный SQLite (только для разработки).
DATABASE_URL=

# Нужно ТОЛЬКО если фронт на другом домене, чем API.
# Когда сайт и /api на одном домене (pulsar.jaglionrus.ru) — оставьте пусто:
# доверие для входа в /admin всё равно подхватит домен из ALLOWED_HOSTS.
CORS_ALLOWED_ORIGINS=

# ---------- ИИ-подбор позиций по описанию задачи (YandexGPT) ----------
# Пока не заполнено, подбор работает на встроенном алгоритме: сайт не ломается,
# просто результаты проще. Ключ создаётся в Yandex Cloud: сервисный аккаунт с
# ролью ai.languageModels.user → API-ключ.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# yandexgpt-lite/latest — дешевле и быстрее, для подбора из 35 позиций хватает.
# Если качество не устроит: yandexgpt/latest
YANDEX_MODEL=yandexgpt-lite/latest
# Сколько секунд ждать модель, потом откат на локальный подбор
ASSIST_TIMEOUT=8
# Лимит частоты запросов с одного адреса (каждый вызов модели платный)
ASSIST_RATE=20/min

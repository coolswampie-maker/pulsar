venv/
.venv/
__pycache__/
*.pyc
db.sqlite3
# Секреты. Правило .env закрывало только сам файл, а копии вроде .env.bak
# или .env.save (их легко оставить после правки на сервере) — нет, и любой
# git add -A утащил бы ключи в коммит. История git постоянна, поэтому
# закрываем весь класс имён сразу, а образец без секретов оставляем.
.env
.env.*
!.env.example
staticfiles/
media/
# журнал запросов к подбору — данные сервера, а не код
logs/
